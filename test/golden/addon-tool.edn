{:tool
 {:name "vectorcraft",
  :inputSchema
  {:type "object",
   :required ["command"],
   :additionalProperties false,
   :properties
   {"command" {:type "string", :enum ["catalog" "doctor" "call"]},
    "query"
    {:type "string",
     :description "Catalog section or exact engine command id."},
    "engine_command"
    {:type "string",
     :description "Exact engine command id to execute."},
    "params" {:type "object", :description "Engine parameters."},
    "id" {:description "Nonnegative integer or string request id."}}}}}
