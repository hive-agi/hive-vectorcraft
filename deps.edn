{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        io.github.hive-agi/hive-addon {:mvn/version "1.1.4"}
        io.github.hive-agi/hive-help {:mvn/version "0.1.6"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.36"}
        metosin/malli {:mvn/version "0.20.2"}
        io.github.hive-agi/hive-schemas {:mvn/version "0.1.40"}}
 :aliases {:dev {:extra-paths ["test" "dev"]
                 :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                              cider/cider-nrepl {:mvn/version "0.62.2"}
                              lambdaisland/kaocha {:mvn/version "1.91.1392"}
                              org.clojure/test.check {:mvn/version "1.1.3"}
                              io.github.hive-agi/hive-test {:mvn/version "0.4.11"}}}
           :test {:extra-paths ["test" "dev"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               org.clojure/test.check {:mvn/version "1.1.3"}
                               io.github.hive-agi/hive-test {:mvn/version "0.4.11"}}
                  :main-opts ["-m" "kaocha.runner"]}
           :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
                   :ns-default hive-build.api}
           :cljs {:extra-paths ["dev"] :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.5"}}}}}
