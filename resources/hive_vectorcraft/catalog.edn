 [{:name "list_commands",
   :title "List commands",
   :description
   "List VectorCraft commands (id, label, menu path, shortcut, parameter description, enabled state). Every editing action is a command; run any of them with run_command. Coordinates are points in document space, y down, origin at the first artboard's top-left.",
   :input-schema-source
   "obj(\n                json!({\"filter\": string(\"Case-insensitive substring matched against id, label and menu path (e.g. \\\"align\\\", \\\"Object\\\")\"), \"enabledOnly\": {\"type\": \"boolean\", \"description\": \"Only commands that can run right now\"}}),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "run_command",
   :title "Run command",
   :description
   "Execute any VectorCraft command by id with JSON params (see list_commands for ids and params). Examples: {\"command\":\"object.group\"}, {\"command\":\"object.align\",\"params\":{\"align\":\"left\"}}, {\"command\":\"file.new\",\"params\":{\"width\":800,\"height\":600}}. Returns the command's result (e.g. {id} for creation commands).",
   :input-schema-source
   "obj(\n                json!({\"command\": string(\"Command id, e.g. shape.rectangle, object.group, paint.setFill\"), \"params\": {\"type\": \"object\", \"description\": \"Command parameters\"}}),\n                &[\"command\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_document",
   :title "Inspect document",
   :description
   "Summary of the active document: artboards, layer tree (ids, names, kinds, bounds, fill/stroke), selection, undo history, current tool and default paint.",
   :input-schema-source "empty()",
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_ui",
   :title "Inspect UI",
   :description
   "UI state of the running desktop app: tool and options, panels, dialogs, view (zoom/center), window, documents, perf. Desktop app only.",
   :input-schema-source "empty()",
   :source "crates/mcp/src/tools.rs"}
  {:name "select_tool",
   :title "Select tool",
   :description
   "Switch the active tool (as clicking it in the Tools panel). Ids: selection, directSelection, groupSelection, pen, rectangle, roundedRectangle, ellipse, polygon, star, lineSegment, …",
   :input-schema-source
   "obj(json!({\"tool\": string(\"Tool id\")}), &[\"tool\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "pointer_gesture",
   :title "Pointer gesture",
   :description
   "Drive the active tool with mouse events in document coordinates, exactly like the mouse would (e.g. a rectangle drag: down at (100,100), drag to (200,150), up at (200,150)). Optionally selects `tool` first.",
   :input-schema-source
   "obj(\n                json!({\n                    \"tool\": string(\"Optional tool to select before the gesture\"),\n                    \"events\": {\n                        \"type\": \"array\",\n                        \"minItems\": 1,\n                        \"items\": obj(json!({\n                            \"kind\": {\"type\": \"string\", \"enum\": [\"down\", \"drag\", \"up\", \"move\", \"doubleclick\"]},\n                            \"x\": num(\"Document x (pt)\"),\n                            \"y\": num(\"Document y (pt)\"),\n                            \"mods\": mods_schema(),\n                            \"pressure\": num(\"Pen pressure 0..1 (default 1): the Liquify tools' intensity with Use Pressure Pen on\"),\n                            \"holdMs\": num(\"Milliseconds the pointer then holds still, button down (0..60000): Twirl, Pucker and Bloat keep applying\"),\n                        }), &[\"kind\", \"x\", \"y\"]),\n                    },\n                    \"mods\": mods_schema(),\n                }),\n                &[\"events\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "draw_path",
   :title "Draw path",
   :description
   "Create a path from points ([[x,y],…] or [{x,y,in?:[x,y],out?:[x,y]},…] with Bézier handles) or SVG path data `d`, then apply optional paint. Returns the new object id.",
   :input-schema-source
   "obj(\n                json!({\n                    \"points\": {\"type\": \"array\", \"description\": \"Anchors: [x,y] pairs or {x, y, in?, out?, smooth?} objects\", \"items\": {\"anyOf\": [{\"type\": \"array\", \"items\": {\"type\": \"number\"}, \"minItems\": 2}, {\"type\": \"object\"}]}},\n                    \"d\": string(\"SVG path data (alternative to points), e.g. \\\"M0 0 L100 0 L50 80 Z\\\"\"),\n                    \"closed\": {\"type\": \"boolean\", \"description\": \"Close the path (points only)\"},\n                    \"fill\": paint_schema(\"Fill\"),\n                    \"stroke\": paint_schema(\"Stroke\"),\n                    \"strokeWidth\": num(\"Stroke weight in pt\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "draw_shape",
   :title "Draw shape",
   :description
   "Create a live shape and apply optional paint. rectangle/ellipse: x, y, width, height (rectangle: radius = corner radius). polygon: cx, cy, radius, sides. star: cx, cy, radius1, radius2, points. line: x1, y1, x2, y2. Returns the new object id.",
   :input-schema-source
   "obj(\n                json!({\n                    \"shape\": {\"type\": \"string\", \"enum\": [\"rectangle\", \"ellipse\", \"polygon\", \"star\", \"line\"]},\n                    \"x\": num(\"Left (rectangle/ellipse)\"),\n                    \"y\": num(\"Top (rectangle/ellipse)\"),\n                    \"width\": num(\"Width (rectangle/ellipse)\"),\n                    \"height\": num(\"Height (rectangle/ellipse)\"),\n                    \"radius\": num(\"Corner radius (rectangle) or radius (polygon)\"),\n                    \"cx\": num(\"Centre x (polygon/star)\"),\n                    \"cy\": num(\"Centre y (polygon/star)\"),\n                    \"sides\": {\"type\": \"integer\", \"minimum\": 3, \"description\": \"Polygon sides (default 6)\"},\n                    \"radius1\": num(\"Star outer radius\"),\n                    \"radius2\": num(\"Star inner radius\"),\n                    \"points\": {\"type\": \"integer\", \"minimum\": 3, \"description\": \"Star points (default 5)\"},\n                    \"rotation\": num(\"Rotation in degrees (polygon/star)\"),\n                    \"x1\": num(\"Line start x\"),\n                    \"y1\": num(\"Line start y\"),\n                    \"x2\": num(\"Line end x\"),\n                    \"y2\": num(\"Line end y\"),\n                    \"fill\": paint_schema(\"Fill\"),\n                    \"stroke\": paint_schema(\"Stroke\"),\n                    \"strokeWidth\": num(\"Stroke weight in pt\"),\n                }),\n                &[\"shape\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "set_paint",
   :title "Set paint",
   :description
   "Set fill, stroke and/or stroke weight on the selection (or `ids`) and as the default for new art.",
   :input-schema-source
   "obj(\n                json!({\n                    \"fill\": paint_schema(\"Fill\"),\n                    \"stroke\": paint_schema(\"Stroke\"),\n                    \"strokeWidth\": num(\"Stroke weight in pt\"),\n                    \"ids\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}, \"description\": \"Object ids (default: the selection)\"},\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "press_key",
   :title "Press key",
   :description
   "Send a key press with modifiers, e.g. {key:\"Z\", mods:{cmd:true}} (undo), {key:\"Escape\"}, {key:\"Enter\"}. In the desktop app it goes through the real keyboard path; headless, it runs the command or tool bound to that shortcut.",
   :input-schema-source
   "obj(\n                json!({\"key\": string(\"Key name: A–Z, 0–9, Enter, Escape, Delete, Backspace, Tab, Space, Left/Right/Up/Down, [ ]…\"), \"mods\": mods_schema()}),\n                &[\"key\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "type_text",
   :title "Type text",
   :description
   "Type text into the focused widget (text tool, dialog field). Desktop app only.",
   :input-schema-source
   "obj(json!({\"text\": string(\"Text to type\")}), &[\"text\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "invoke_menu",
   :title "Invoke menu",
   :description
   "Invoke a menu item by its command id (same ids as list_commands, including UI-only commands like view.zoomIn or window.* in the desktop app).",
   :input-schema-source
   "obj(json!({\"command\": string(\"Menu command id\"), \"params\": {\"type\": \"object\"}}), &[\"command\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "open_panel",
   :title "Open panel",
   :description
   "Open a panel in the desktop app's dock (e.g. Layers, Swatches, Stroke, Align, Pathfinder, Transform). Desktop app only.",
   :input-schema-source
   "obj(json!({\"panel\": string(\"Panel name\")}), &[\"panel\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "screenshot",
   :title "Screenshot",
   :description
   "Render the active artboard to PNG and return it as an image (optionally also saving it to `path`). With window:true (desktop app only) captures the whole app window instead.",
   :input-schema-source
   "obj(\n                json!({\n                    \"path\": string(\"Also write the PNG here\"),\n                    \"scale\": num(\"Pixels per point (default 1)\"),\n                    \"artboard\": {\"type\": \"integer\", \"minimum\": 0, \"description\": \"Artboard index (default 0)\"},\n                    \"window\": {\"type\": \"boolean\", \"description\": \"Capture the app window (desktop app only)\"},\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "open_file",
   :title "Open file",
   :description &format!,
   :input-schema-source
   "obj(json!({\"path\": string(\"File path\")}), &[\"path\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "save_file",
   :title "Save file",
   :description &format!,
   :input-schema-source
   "obj(json!({\"path\": string(\"Destination; its extension picks the format (default: the document's own file)\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "export",
   :title "Export",
   :description
   "Export the active document with the engine's document.export (the same bytes in the app and headless), in any format of the `format` enum: vectors (svg/svgz with the artboard as viewBox, eps, dxf, emf, wmf), pdf (one page per artboard: all, or `artboard` / `range`), rasters (one rendered artboard: png, jpg, webp, gif, png8 as an indexed .png, tiff, bmp, tga, psd with its layers), txt (the stories, back to front), vectorcraft or template (a native copy or template; the document keeps its path). run_command document.formats lists each format's options. `selection: true` exports only the selected objects, cropped to their bounds. Template layers are left out; live effects are kept (geometry baked, SVG filters for shadows/glows/blur). Without `path` the bytes come back as dataBase64.",
   :input-schema-source
   "obj(\n                json!({\n                    \"format\": {\"type\": \"string\", \"enum\": FORMATS.iter().filter(|f| f.write).map(|f| f.id).collect::<Vec<_>>(), \"description\": \"Default: from the path's extension\"},\n                    \"path\": string(\"Destination file (omit to get dataBase64)\"),\n                    \"scale\": num(\"Raster pixels per point (default 1)\"),\n                    \"artboard\": {\"type\": \"integer\", \"minimum\": 0, \"description\": \"0-based artboard (default: the first; PDF default: all)\"},\n                    \"range\": string(\"1-based artboards such as \\\"1-3, 5\\\" (PDF: one page each; other formats take one)\"),\n                    \"selection\": {\"type\": \"boolean\", \"description\": \"Export only the selection, cropped to it\"},\n                    \"outlineText\": {\"type\": \"boolean\", \"description\": \"SVG: text as outlines (viewable without the fonts)\"},\n                    \"options\": {\"type\": \"object\", \"description\": \"More format options, passed through (see run_command document.formats), e.g. {\\\"quality\\\": 80} for jpg\"},\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "add_text",
   :title "Add text",
   :description
   "Create point type at (x, y) (the first baseline), area type when width/height are given, or type in/on an existing path (`path` id + `mode` area|onPath; `pathEffect` rainbow|skew|3dRibbon|stairStep|gravity). Returns the text object id.",
   :input-schema-source
   "obj(\n                json!({\n                    \"text\": {\"type\": \"string\"},\n                    \"x\": num(\"Baseline origin x (point/area type: left)\"),\n                    \"y\": num(\"First baseline y (area type: top)\"),\n                    \"width\": num(\"Area type frame width\"),\n                    \"height\": num(\"Area type frame height\"),\n                    \"path\": {\"type\": \"integer\", \"description\": \"Existing path id to flow the text in (area) or along (onPath)\"},\n                    \"mode\": {\"type\": \"string\", \"enum\": [\"area\", \"onPath\"]},\n                    \"pathEffect\": {\"type\": \"string\", \"enum\": [\"rainbow\", \"skew\", \"3dRibbon\", \"stairStep\", \"gravity\"]},\n                    \"size\": num(\"Font size in pt\"),\n                    \"font\": {\"type\": \"string\", \"description\": \"Font family\"},\n                    \"color\": paint_schema(\"Text colour (#rrggbb)\"),\n                }),\n                &[\"text\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "apply_effect",
   :title "Apply live effect",
   :description
   "Append a live effect (Effect menu) to the selection or `ids`. Omit `effect` to get the catalogue (ids, parameters, defaults). Examples: stylize.dropShadow {x, y, blur, opacity}, distort.roughen, warp.arc {bend}, path.offsetPath {offset}, pathfinder.add (on groups), blur.gaussian {radius}.",
   :input-schema-source
   "obj(\n                json!({\n                    \"effect\": {\"type\": \"string\", \"description\": \"Effect id (see the catalogue)\"},\n                    \"params\": {\"type\": \"object\", \"description\": \"Effect parameters; missing keys take the dialog defaults\"},\n                    \"ids\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}},\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "pathfinder",
   :title "Pathfinder",
   :description
   "Combine the selected (or `ids`) objects destructively, back to front: unite, minusFront, intersect, exclude, divide, trim, merge, crop, outline, minusBack. For a non-destructive version apply the pathfinder.* effect to a group.",
   :input-schema-source
   "obj(\n                json!({\n                    \"operation\": {\"type\": \"string\", \"enum\": [\"unite\", \"minusFront\", \"intersect\", \"exclude\", \"divide\", \"trim\", \"merge\", \"crop\", \"outline\", \"minusBack\"]},\n                    \"ids\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}},\n                }),\n                &[\"operation\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "transform",
   :title "Transform",
   :description
   "Move, rotate, scale, reflect or shear the selection (or `ids`); several may be combined and run in that order. Angles in degrees (counter-clockwise), scale in %. `origin` [x,y] defaults to the selection centre; `copy` transforms a copy.",
   :input-schema-source
   "obj(\n                json!({\n                    \"ids\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}},\n                    \"dx\": num(\"Move right\"),\n                    \"dy\": num(\"Move down\"),\n                    \"rotate\": num(\"Rotation in degrees\"),\n                    \"scale\": num(\"Uniform scale in %\"),\n                    \"scaleX\": num(\"Horizontal scale in %\"),\n                    \"scaleY\": num(\"Vertical scale in %\"),\n                    \"reflect\": {\"type\": \"string\", \"enum\": [\"vertical\", \"horizontal\"]},\n                    \"shear\": num(\"Shear angle in degrees (horizontal axis)\"),\n                    \"origin\": {\"type\": \"array\", \"items\": {\"type\": \"number\"}, \"minItems\": 2, \"maxItems\": 2},\n                    \"copy\": {\"type\": \"boolean\"},\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "create_graph",
   :title "Create graph",
   :description
   "Create a graph (graph tools) in the plot rectangle. Data as `csv` (first row: empty cell then series names; then one row per category: label, values…) or `series`/`categories`/`rows`. Edit later with run_command graph.setData / graph.setType.",
   :input-schema-source
